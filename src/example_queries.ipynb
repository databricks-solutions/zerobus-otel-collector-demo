    "{\n",
    " \"cells\": [\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"SqlCellData\": {\n",
    "     \"variableName$1\": \"df_sql1\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": [\n",
    "    \"%%sql\\n\",\n",
    "    \"-- Recent logs with body and attributes\\n\",\n",
    "    \"SELECT\\n\",\n",
    "    \"  time,\\n\",\n",
    "    \"  service_name,\\n\",\n",
    "    \"  severity_text,\\n\",\n",
    "    \"  body::string AS message,\\n\",\n",
    "    \"  attributes:['exception.type']::string AS exception_type\\n\",\n",
    "    \"FROM <catalog>.<schema>.<prefix>_otel_logs\\n\",\n",
    "    \"WHERE time > current_timestamp() - INTERVAL 1 HOUR\\n\",\n",
    "    \"ORDER BY time DESC\\n\",\n",
    "    \"LIMIT 100;\"\n",
    "   ],\n",
    "   \"id\": \"c2d82c40d877cc46\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"SqlCellData\": {\n",
    "     \"variableName$1\": \"df_sql2\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": [\n",
    "    \"%%sql\\n\",\n",
    "    \"-- Error logs by service\\n\",\n",
    "    \"SELECT\\n\",\n",
    "    \"  service_name,\\n\",\n",
    "    \"  severity_text,\\n\",\n",
    "    \"  COUNT(*) AS log_count\\n\",\n",
    "    \"FROM <catalog>.<schema>.<prefix>_otel_logs\\n\",\n",
    "    \"WHERE severity_text IN ('ERROR', 'WARN')\\n\",\n",
    "    \"  AND time > current_timestamp() - INTERVAL 1 HOUR\\n\",\n",
    "    \"GROUP BY service_name, severity_text\\n\",\n",
    "    \"ORDER BY log_count DESC;\"\n",
    "   ],\n",
    "   \"id\": \"a92d8ba67d4c7277\"\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"SqlCellData\": {\n",
    "     \"variableName$1\": \"df_sql3\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"outputs\": [],\n",
    "   \"execution_count\": null,\n",
    "   \"source\": [\n",
    "    \"%%sql\\n\",\n",
    "    \"-- Structured log body\\n\",\n",
    "    \"SELECT\\n\",\n",
    "    \"  time,\\n\",\n",
    "    \"  service_name,\\n\",\n",
    "    \"  body:message::string AS message,\\n\",\n",
    "    \"  body:error.code::int AS error_code\\n\",\n",
    "    \"FROM <catalog>.<schema>.<prefix>_otel_logs\\n\",\n",
    "    \"WHERE time > current_timestamp() - INTERVAL 1 HOUR\\n\",\n",
    "    \"  AND body:error.code IS NOT NULL;\"\n",
    "   ],\n",
    "   \"id\": \"a4aa9d24c29aff5a\"\n",
    "  }\n",
    " ],\n",
