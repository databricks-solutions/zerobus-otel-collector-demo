# Local development env vars. Copy to `.env` and fill in.
# (.env is gitignored — never commit secrets.)

# Pick the Databricks CLI profile to use locally. Leave blank to fall back to
# the SDK default chain (which honors DATABRICKS_HOST + DATABRICKS_TOKEN env vars).
DATABRICKS_PROFILE=DEFAULT

# Required — your serverless SQL warehouse ID.
DATABRICKS_WAREHOUSE_ID=

# Required — Genie Space ID over the OTel silver tables.
GENIE_SPACE_ID=

# Optional overrides (defaults shown).
OTEL_CATALOG=otel
OTEL_SCHEMA=kubernetes_otel_silver
